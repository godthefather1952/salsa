# Copy to apps/api/.env to override defaults. Everything here is optional.

# Zero-setup local database (Postgres running inside Node, stored in apps/api/.data).
DATABASE_URL=pglite://.data/salsa

# Or a real Postgres: `docker compose up -d` from the repo root, then:
# DATABASE_URL=postgres://salsa:salsa@localhost:5432/salsa

# Or a hosted database (Neon, Supabase): paste its connection string.

PORT=3001
LOG_LEVEL=info
